# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env нельзя загружать в GitHub (он уже в .gitignore).

NODE_ENV=development
PORT=3000

# Строка подключения к PostgreSQL.
# Локально:  postgres://postgres:пароль@localhost:5432/yieldflow
# Neon:      скопируйте из панели Neon (Connection string), в ней уже есть sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yieldflow

# Длинная случайная строка (минимум 32 символа) для подписи токенов входа.
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Сколько секунд действует вход (28800 = 8 часов)
JWT_EXPIRES_IN_SECONDS=28800

# Первый администратор. Создаётся один раз, когда в базе нет ни одного пользователя.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Сайты, которым разрешено обращаться к API (через запятую)
CORS_ORIGINS=http://localhost:4200

# Заполнить пустую базу демо-данными птицефабрики (true/false)
SEED_DEMO_DATA=true
